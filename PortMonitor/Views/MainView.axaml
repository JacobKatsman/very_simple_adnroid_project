<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PortMonitor.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="PortMonitor.Views.MainView"
             x:DataType="vm:MainViewModel">
  
<UserControl.Styles>
    <Style Selector="Button.calc">
        <Setter Property="Margin" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <!-- Выравнивание содержимого по центру -->
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!-- Крупный жирный шрифт — цифры не "теряются" в большой кнопке -->
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <!-- Убираем лишние внутренние отступы, если они есть -->
        <Setter Property="Padding" Value="0"/>
    </Style>
</UserControl.Styles>
    

    <Grid RowDefinitions="Auto,Auto,*,*,*,*" Margin="4">

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Калькулятор" FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,8"/>


	 <!-- Окно вывода -->
	 <Border Grid.Row="1"
		 Background="#1B2A1F"
		 BorderBrush="#0E1610"
		 BorderThickness="2"
		 CornerRadius="8"
		 Padding="16,8"
		 Margin="0,0,0,8">
	     <Border.Styles>
		 <!-- Лёгкий «вдавленный» эффект: внутренняя тень имитируется второй рамкой -->
		 <Style Selector="Border">
		     <Setter Property="BoxShadow" Value="inset 0 2 6 0 #000000AA"/>
		 </Style>
	     </Border.Styles>

	     <TextBlock x:Name="DisplayText"
			Text="0"
			FontFamily="monospace"
			FontSize="42"
			FontWeight="Bold"
			Foreground="#7CFC8A"
			HorizontalAlignment="Right"
			VerticalAlignment="Center"
			TextAlignment="Right"
			TextWrapping="NoWrap"/>
          </Border>
 

        <!-- Ряд 1: 7 8 9 / -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*">
            <Button Classes="calc" Grid.Column="0" Content="7" Tag="7"/>
            <Button Classes="calc" Grid.Column="1" Content="8" Tag="8"/>
            <Button Classes="calc" Grid.Column="2" Content="9" Tag="9"/>
            <Button Classes="calc" Grid.Column="3" Content="/" Tag="/" Background="#FF9800"/>
        </Grid>

        <!-- Ряд 2: 4 5 6 * -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*,*,*">
            <Button Classes="calc" Grid.Column="0" Content="4" Tag="4"/>
            <Button Classes="calc" Grid.Column="1" Content="5" Tag="5"/>
            <Button Classes="calc" Grid.Column="2" Content="6" Tag="6"/>
            <Button Classes="calc" Grid.Column="3" Content="*" Tag="*" Background="#FF9800"/>
        </Grid>

        <!-- Ряд 3: 1 2 3 - -->
        <Grid Grid.Row="4" ColumnDefinitions="*,*,*,*">
            <Button Classes="calc" Grid.Column="0" Content="1" Tag="1"/>
            <Button Classes="calc" Grid.Column="1" Content="2" Tag="2"/>
            <Button Classes="calc" Grid.Column="2" Content="3" Tag="3"/>
            <Button Classes="calc" Grid.Column="3" Content="-" Tag="-" Background="#FF9800"/>
        </Grid>

        <!-- Ряд 4: C 0 = + -->
        <Grid Grid.Row="5" ColumnDefinitions="*,*,*,*">
            <Button Classes="calc" Grid.Column="0" Content="C" Tag="C" Background="#F44336"/>
            <Button Classes="calc" Grid.Column="1" Content="0" Tag="0"/>
            <Button Classes="calc" Grid.Column="2" Content="=" Tag="=" Background="#4CAF50"/>
            <Button Classes="calc" Grid.Column="3" Content="+" Tag="+" Background="#FF9800"/>
        </Grid>
    </Grid>
</UserControl>






